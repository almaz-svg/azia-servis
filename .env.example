# Публичные значения: anon key безопасен в браузере, потому что доступ к таблицам закрыт RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Режим апробации: live — Supabase; snapshot — запасной снимок ответов (supabase/fixtures).
NEXT_PUBLIC_TRIAL_SOURCE=live

# Только сервер (/api/note, появится в К5). Никогда не добавлять с префиксом NEXT_PUBLIC_.
LLM_API_KEY=
